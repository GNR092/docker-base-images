# =============================================================================
# Stage 1: Builder - compile PHP extensions and install Python + deps
# =============================================================================
FROM php:8.5.11-fpm-bookworm AS builder

# Install ALL dependencies (runtime + build) in one layer
RUN apt-get update && apt-get install -y --no-install-recommends \
        # Runtime libraries
        libzip4 \
        libpng16-16 \
        libjpeg62-turbo \
        libwebp7 \
        libfreetype6 \
        libicu72 \
        libgmp10 \
        libonig5 \
        git \
        curl \
        unzip \
        bash \
        sqlite3 \
        libxml2 \
        libpq5 \
        python3 \
        python3-pip \
        # Build dependencies
        libzip-dev \
        libpng-dev \
        libjpeg-dev \
        libwebp-dev \
        libfreetype-dev \
        libicu-dev \
        libgmp-dev \
        libonig-dev \
        make \
        gcc \
        g++ \
        autoconf \
        libc6-dev \
        pkg-config \
        libsqlite3-dev \
        libxml2-dev \
        libpq-dev \
    && rm -rf /var/lib/apt/lists/*

# Install Composer
COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

# Configure and install PHP extensions
RUN docker-php-ext-configure gd --with-freetype --with-jpeg --with-webp && \
    docker-php-ext-install -j$(nproc) \
        pdo_pgsql \
        pgsql \
        mbstring \
        exif \
        pcntl \
        bcmath \
        gd \
        zip \
        intl \
        gmp \
        posix && \
    pecl install redis && \
    docker-php-ext-enable redis

# Install Python dependencies (including Playwright)
RUN pip install --no-cache-dir --break-system-packages \
        playwright>=1.40 \
        httpx>=0.25 \
        python-dotenv>=1.0 \
        openpyxl>=3.1 && \
    playwright install chromium && \
    playwright install-deps chromium

# =============================================================================
# Stage 2: Runtime - minimal image with compiled artifacts + Python deps
# =============================================================================
FROM php:8.5.11-fpm-bookworm AS runtime

LABEL org.opencontainers.image.title="weblaravel-pypsgl-worker" \
      org.opencontainers.image.description="PHP-FPM 8.5.11 + Python 3.11 + Playwright worker (Debian bookworm)" \
      org.opencontainers.image.version="2026.10.19" \
      org.opencontainers.image.base.name="docker.io/library/php:8.5.11-fpm-bookworm"

# Install ONLY runtime dependencies + Playwright runtime deps
RUN apt-get update && apt-get install -y --no-install-recommends \
        libzip4 \
        libpng16-16 \
        libjpeg62-turbo \
        libwebp7 \
        libfreetype6 \
        libicu72 \
        libgmp10 \
        libonig5 \
        git \
        curl \
        unzip \
        bash \
        sqlite3 \
        libxml2 \
        libpq5 \
        python3 \
        python3-pip \
        gosu \
        # Playwright runtime dependencies (chromium bundle)
        libnss3 \
        libnspr4 \
        libatk1.0-0 \
        libatk-bridge2.0-0 \
        libdrm2 \
        libxkbcommon0 \
        libxcomposite1 \
        libxdamage1 \
        libxrandr2 \
        libxfixes3 \
        libxext6 \
        libx11-6 \
        libxcb1 \
        libgbm1 \
        libglib2.0-0 \
        libcairo2 \
        libpango-1.0-0 \
        libcups2 \
        libdbus-1-3 \
        libexpat1 \
        libasound2 \
        libatspi2.0-0 \
        fonts-liberation \
        fonts-noto-color-emoji \
    && rm -rf /var/lib/apt/lists/*

# Copy compiled PHP extensions from builder
COPY --from=builder /usr/local/lib/php/extensions/ /usr/local/lib/php/extensions/
COPY --from=builder /usr/local/etc/php/conf.d/docker-php-ext-*.ini /usr/local/etc/php/conf.d/

# Copy Composer binary
COPY --from=builder /usr/bin/composer /usr/bin/composer

# Copy Python runtime + packages + Playwright browsers
# Browsers en una sola ruta compartida; independiente de HOME y del uid.
COPY --from=builder /usr/local/lib/python3.11/ /usr/local/lib/python3.11/
COPY --from=builder /usr/bin/python3 /usr/bin/python3
COPY --from=builder /usr/bin/pip3 /usr/bin/pip3
COPY --from=builder /root/.cache/ms-playwright/ /opt/ms-playwright/
RUN chmod -R a+rX /opt/ms-playwright/
ENV PLAYWRIGHT_BROWSERS_PATH=/opt/ms-playwright \
    HOME=/var/www

# Set working directory
WORKDIR /var/www/html

# Expose port 9000 for PHP-FPM
EXPOSE 9000

# Set entrypoint script
COPY entrypoint-debian.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh

ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
CMD ["php-fpm"]