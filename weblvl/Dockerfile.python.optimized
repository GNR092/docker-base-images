# =============================================================================
# weblvl Python optimized + Xdebug (PHP 8.4)
# =============================================================================
# Reutiliza la imagen base gnr092/base-php8.4-fpm-xdebug (PHP 8.4 + Xdebug
# configurable por env + OPcache + Composer + entrypoint con envsubst) y solo
# añade la capa Python. Evita duplicar las ~280 líneas del Dockerfile base.
#
# Build:
#   docker build -f Dockerfile.python.optimized -t gnr092/weblvl:py-xdebug .
# Run dev con Xdebug:
#   docker run --rm -e XDEBUG_MODE=debug,develop \
#     -e XDEBUG_CLIENT_HOST=host.docker.internal \
#     --add-host=host.docker.internal:host-gateway \
#     gnr092/weblvl:py-xdebug php -m | grep -i xdebug
# =============================================================================
ARG BASE_IMAGE=gnr092/base-php8.4-fpm-xdebug:8.4-xdebug3.4-alpine3.22
FROM ${BASE_IMAGE}

USER root

WORKDIR /var/www/html

# Solo runtime de Python: sin gcc/make -> capa pequeña (~50-60 MB).
# py3-pip permite `pip install --break-system-packages` si el worker lo necesita.
RUN apk add --no-cache \
        python3 \
        py3-pip \
    && rm -rf /var/cache/apk/* \
    && python3 --version \
    && pip3 --version

# Entrypoint híbrido: envsubst Xdebug (de la base) + vendor/storage/artisan (weblvl)
COPY entrypoint-python-xdebug.sh /usr/local/bin/entrypoint-python-xdebug.sh
RUN chmod +x /usr/local/bin/entrypoint-python-xdebug.sh

EXPOSE 9000

ENTRYPOINT ["/usr/local/bin/entrypoint-python-xdebug.sh"]
CMD ["php-fpm"]
