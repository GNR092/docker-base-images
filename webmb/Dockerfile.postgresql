FROM php:8.3.8-fpm-alpine3.20

# 1. Dependencias del sistema para PostgreSQL y PHP
RUN apk update && apk add --no-cache \
    postgresql-client \
    postgresql-dev \
    git \
    zip \
    unzip \
    oniguruma-dev \
    autoconf \
    build-base \
    imagemagick-dev \
    libzip-dev \
    libpng-dev \
    libjpeg-turbo-dev \
    libwebp-dev \
    libxml2-dev \
    icu-dev \
    freetype-dev

# 2. Configurar e instalar extensiones de PHP (solo PostgreSQL)
RUN docker-php-ext-configure gd --with-freetype --with-jpeg --with-webp \
    && docker-php-ext-install -j$(nproc) \
    pgsql \
    pdo_pgsql \
    mbstring \
    exif \
    pcntl \
    gd \
    opcache \
    zip \
    bcmath \
    intl \
    soap

# 3. Composer
COPY --from=composer/composer:latest-bin /composer /usr/bin/composer

# 4. Gestión de usuarios
ARG PUID=1000
ARG PGID=1000

RUN deluser nobody || true \
    && delgroup nobody || true \
    && addgroup -g ${PGID} nobody \
    && adduser -u ${PUID} -G nobody -s /bin/sh -D nobody

WORKDIR /var/www/html

# 5. Configuración y permisos
RUN chown -R nobody:nobody /var/www/html/ \
    && chmod -R 775 /var/www/html/

COPY nginx.conf /etc/nginx/nginx.conf
COPY php-fpm.conf /usr/local/etc/php-fpm.d/www.conf
COPY opcache.ini /usr/local/etc/php/conf.d/opcache.ini
COPY entrypoint.sh /entrypoint.sh

RUN chmod +x /entrypoint.sh \
    && git config --global core.fileMode false \
    && git config --global --add safe.directory /var/www/html \
    && mkdir -p /var/log/nginx \
    && chown nobody:nobody /var/log/nginx

ENV APP_MODE=new
EXPOSE 9000

ENTRYPOINT ["/entrypoint.sh"]
CMD ["php-fpm"]
