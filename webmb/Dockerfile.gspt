FROM php:8.3.8-fpm-alpine3.20

ARG GSPDL_VERSION=10.07.0

# 1. Dependencias del sistema
RUN apk update && apk add --no-cache \
    mysql-client \
    git \
    zip \
    unzip \
    oniguruma-dev \
    autoconf \
    build-base \
    imagemagick-dev \
    libzip-dev \
    libpng-dev \
    libjpeg-turbo-dev \
    libwebp-dev \
    libxml2-dev \
    icu-dev \
    freetype-dev

# 2. Instalar GhostPDL (sin entorno grafico)
RUN apk add --no-cache --virtual .gspdl-build-deps \
    curl \
    make \
    pkgconf \
    python3 \
    perl \
    zlib-dev \
    jpeg-dev \
    libpng-dev \
    tiff-dev \
    freetype-dev \
    lcms2-dev \
    openjpeg-dev \
    jbig2dec-dev \
    && GSPDL_TAG="gs$(printf '%s' "$GSPDL_VERSION" | tr -d '.')" \
    && GSPDL_URL="https://github.com/ArtifexSoftware/ghostpdl-downloads/releases/download/${GSPDL_TAG}/ghostpdl-${GSPDL_VERSION}.tar.gz" \
    && echo "Downloading: ${GSPDL_URL}" \
    && curl -fL "${GSPDL_URL}" -o /tmp/ghostpdl.tar.gz \
    && mkdir -p /tmp/ghostpdl-src \
    && tar -xzf /tmp/ghostpdl.tar.gz -C /tmp/ghostpdl-src --strip-components=1 \
    && cd /tmp/ghostpdl-src \
    && CFLAGS="-DDO_NOT_USE_SPRINTF=sprintf" ./configure --disable-gtk --without-x \
    && make -j1 \
    && make install \
    && apk add --no-cache \
    tiff \
    lcms2 \
    openjpeg \
    jbig2dec \
    zlib \
    libjpeg-turbo \
    libpng \
    freetype \
    && gs --version \
    && cd / \
    && rm -rf /tmp/ghostpdl.tar.gz /tmp/ghostpdl-src \
    && apk del .gspdl-build-deps

# 3. Configurar e Instalar extensiones de PHP
RUN docker-php-ext-configure gd --with-freetype --with-jpeg --with-webp \
    && docker-php-ext-install -j$(nproc) \
    mysqli \
    pdo_mysql \
    mbstring \
    exif \
    pcntl \
    gd \
    opcache \
    zip \
    bcmath \
    intl \
    soap

# 4. Composer
COPY --from=composer/composer:latest-bin /composer /usr/bin/composer

# 5. Gestión de Usuarios
# Nota: Usar 'nobody' es válido, pero CI4 suele preferir un nombre de usuario dedicado
# para evitar conflictos con procesos del sistema Alpine
ARG PUID=1000
ARG PGID=1000

RUN deluser nobody || true \
    && delgroup nobody || true \
    && addgroup -g ${PGID} nobody \
    && adduser -u ${PUID} -G nobody -s /bin/sh -D nobody

WORKDIR /var/www/html

# 6. Configuración y Permisos
# Importante: chown debe ser recursivo para las carpetas writable de CI4
RUN chown -R nobody:nobody /var/www/html/ \
    && chmod -R 775 /var/www/html/

COPY nginx.conf /etc/nginx/nginx.conf
COPY php-fpm.conf /usr/local/etc/php-fpm.d/www.conf
COPY opcache.ini /usr/local/etc/php/conf.d/opcache.ini
COPY entrypoint.sh /entrypoint.sh

RUN chmod +x /entrypoint.sh && \
    git config --global core.fileMode false && \
    git config --global --add safe.directory /var/www/html && \
    mkdir -p /var/log/nginx && \
    chown nobody:nobody /var/log/nginx

ENV APP_MODE=new
EXPOSE 9000

ENTRYPOINT ["/entrypoint.sh"]
CMD ["php-fpm"]
